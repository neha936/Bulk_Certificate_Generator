# Copy to .env and adjust. Every value is optional; defaults are shown.

APP_NAME="Bulk Certificate Generator API"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local fallback (no setup needed):
DATABASE_URL=sqlite:///./certificates.db
# PostgreSQL (used by docker-compose):
# DATABASE_URL=postgresql+psycopg://certs:certs@localhost:5432/certificates

STORAGE_DIR=./storage/certificates
CERTIFICATE_LAYOUT_PATH=./static/templates/certificate_layout.json
MAX_RECIPIENTS_PER_JOB=1000

# Set to false in production and run migrations instead.
AUTO_CREATE_TABLES=true
